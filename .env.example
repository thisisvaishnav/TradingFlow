# PostgreSQL connection string (Neon DB)
# Get from: Neon dashboard → your project → Connection Details → Connection string
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret for auth tokens (use a strong random string)
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-secret

# Executor polling interval in milliseconds
EXECUTOR_POLL_INTERVAL_MS=10000

# Resend email service
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="TradingFlow <noreply@yourdomain.com>"

# Backend CORS — comma-separated origins allowed to call the API
# Set this to your frontend domain in production
CORS_ORIGIN=https://tradingflow.yourdomain.com

# Client build — the API URL the frontend will call
# Used at BUILD TIME by Vite (prefix with VITE_)
VITE_API_BASE_URL=https://tradingflow.yourdomain.com/api

# Backend port (defaults to 3001)
PORT=3001
